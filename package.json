{
  "name": "dictly",
  "version": "0.0.0",
  "description": "Typed i18n for TypeScript and React: the dictionary is a plain object, translations are property access, placeholders are typed from the strings.",
  "keywords": [
    "i18n",
    "l10n",
    "typescript",
    "react",
    "typed-dictionary",
    "plain-i18n",
    "translation",
    "plural"
  ],
  "license": "MIT",
  "author": "Artur Ovcharenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axtew/dictly.git"
  },
  "homepage": "https://github.com/axtew/dictly#readme",
  "bugs": "https://github.com/axtew/dictly/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile esm-only",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck:compat": "pnpm --package=typescript@5.0 dlx tsc -p tsconfig.compat.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.10.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "~7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=18"
  }
}
